{
  "name": "mergepilot-ai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "dev:marketing": "pnpm --dir apps/marketing dev",
    "build": "pnpm --dir apps/web build",
    "build:marketing": "pnpm --dir apps/marketing build",
    "start": "pnpm --dir apps/web start -H 0.0.0.0",
    "lint": "pnpm --dir apps/web lint",
    "test": "vitest run",
    "lint-staged": "lint-staged",
    "format": "prettier . --write",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "prepare": "node -e \"if (process.env.NODE_ENV === 'production' || process.env.CI || process.env.RENDER) process.exit(0); try { require('child_process').execSync('pnpm exec husky', { stdio: 'inherit' }); } catch {}\""
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-tailwindcss": "^3.18.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "next": "^15.3.4",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.10.0",
    "@google/genai": "^2.17.1",
    "@octokit/rest": "^22.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.4",
    "lucide-react": "^0.525.0",
    "next-auth": "5.0.0-beta.29",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.14"
  }
}
